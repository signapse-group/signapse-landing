---
import type { Locale } from '@/i18n/config';
import { SIGNAPSE_VERCEL_ANALYTICS } from 'astro:env/server';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { landingMetadata } from '@/lib/landing-metadata';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  socialImageAlt: string;
  root?: boolean;
  canonicalPaths?: Partial<Record<Locale, string>>;
  openGraphType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  forceNoindex?: boolean;
  canonicalOverride?: string | null;
  hideAlternates?: boolean;
}

const {
  locale,
  title,
  description,
  socialImageAlt,
  root = false,
  canonicalPaths,
  openGraphType = 'website',
  publishedTime,
  modifiedTime,
  forceNoindex = false,
  canonicalOverride,
  hideAlternates = false,
} = Astro.props;
const metadata = landingMetadata(locale, root, canonicalPaths);
const canonical =
  canonicalOverride === undefined ? metadata.canonical : canonicalOverride;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="robots"
      content={forceNoindex ? 'noindex, follow' : metadata.robots}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {!hideAlternates &&
      metadata.alternates.map(({ language, href }) => (
        <link rel="alternate" hreflang={language} href={href} />
      ))}
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content="Signapse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'vi' ? 'vi_VN' : 'en_US'} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={metadata.socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metadata.socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body class="min-h-svh font-sans antialiased">
    <slot />
    {SIGNAPSE_VERCEL_ANALYTICS && (
      <>
        <Analytics />
        <SpeedInsights />
      </>
    )}
  </body>
</html>
