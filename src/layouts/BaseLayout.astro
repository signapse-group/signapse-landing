---
import type { Locale } from '@/i18n/config';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
  </head>
  <body class="min-h-svh bg-slate-50 font-sans text-slate-900 antialiased">
    <slot />
  </body>
</html>
