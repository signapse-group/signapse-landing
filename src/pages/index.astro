---
import { DEFAULT_LOCALE } from '@/i18n/config';
import { messages } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LandingPage from '@/components/landing/LandingPage.astro';

const dictionary = messages[DEFAULT_LOCALE];
---

<BaseLayout locale={DEFAULT_LOCALE} {...dictionary.landing.metadata} root>
  <LandingPage dictionary={dictionary} locale={DEFAULT_LOCALE} />
</BaseLayout>
