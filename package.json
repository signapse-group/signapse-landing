{
  "name": "signapse-landing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint src astro.config.mjs eslint.config.mjs .prettierrc.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "astro build",
    "preview": "astro preview",
    "test:models": "node --experimental-strip-types --test tests/models/*.test.mjs",
    "test:browser": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test": "pnpm test:models && pnpm test:browser"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@base-ui/react": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "astro": "7.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "motion": "13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "4.143.0"
  }
}
