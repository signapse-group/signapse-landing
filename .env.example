# Product application origin for dashboard and Articles links.
# For Cloudflare release, configure origins in GitHub Variables; see docs/deployment/signapse-cloud.md.
PUBLIC_APP_ORIGIN=http://localhost:3000
# Public contact API origin, configured independently from the product application.
PUBLIC_CONTACT_API_ORIGIN=https://dev-api.signapse.cloud
# Synthetic HTTPS origin for local noindex metadata/browser checks.
# Replace with the actual public origin only for a deployed preview.
SIGNAPSE_PUBLIC_ORIGIN=https://landing.example.test
SIGNAPSE_LANDING_INDEXABLE=false

# Only enable on hosting configured with Vercel Analytics / Speed Insights endpoints.
SIGNAPSE_VERCEL_ANALYTICS=false
# CI supplies the checked commit SHA; omit for preview (revision is null).
SIGNAPSE_BUILD_REVISION=
