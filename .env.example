# Product application origin for dashboard and Articles links.
# For Cloudflare release, configure origins in GitHub Variables; see docs/deployment/signapse-cloud.md.
PUBLIC_APP_ORIGIN=http://localhost:3000
# Explicit HTTPS landing origin, without path/query/credentials. Optional in noindex previews.
# SIGNAPSE_PUBLIC_ORIGIN=https://your-landing-preview.example
SIGNAPSE_LANDING_INDEXABLE=false

# Only enable on hosting configured with Vercel Analytics / Speed Insights endpoints.
SIGNAPSE_VERCEL_ANALYTICS=false
